// Base locale SQLite : la machine n'a pas Docker.
// docker-compose.yml à la racine prépare PostgreSQL. Le jour où il tourne,
// passer provider à "postgresql" et DATABASE_URL vers ce serveur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  isDemo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Category {
  id       String    @id @default(cuid())
  name     String
  key      String    @unique
  parent   String    @default("Livres")
  isGames  Boolean   @default(false)
  visible  Boolean   @default(true)
  products Product[]
}

model Product {
  id         String   @id @default(cuid())
  title      String
  type       String
  blurb       String   @default("")
  description String   @default("")
  advice      String   @default("")
  author     String   @default("")
  priceEur   Float
  priceXof   Int
  compareEur Float?
  stock      Int      @default(0)
  lowStock   Int      @default(5)
  ageBand    String
  status     String   @default("draft")
  isDemo     Boolean  @default(true)
  imageUrl   String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews    Review[]
  favorites  Favorite[]
  cartItems  CartItem[]
  createdAt  DateTime @default(now())
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String   @default("")
  status    String   @default("draft")
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  status    String   @default("draft")
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Collection {
  id       String  @id @default(cuid())
  name     String
  blurb    String  @default("")
  startsOn String
  endsOn   String
  active   Boolean @default(true)
  isDemo   Boolean @default(true)
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  createdAt DateTime @default(now())
}

model Promotion {
  id        String   @id @default(cuid())
  name      String
  percent   Int
  scope     String
  active    Boolean  @default(true)
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  rating     Int      @default(5)
  status     String   @default("pending")
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Customer {
  id        String     @id @default(cuid())
  name      String     @default("")
  email     String     @default("")
  phone     String     @default("")
  createdAt DateTime   @default(now())
  favorites Favorite[]
  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty        Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Domicile")
  line       String
  city       String   @default("")
  country    String
  createdAt  DateTime @default(now())
}

model Order {
  id          String    @id @default(cuid())
  number      String    @unique
  destination String
  totalEur    Float
  payment     String
  status      String    @default("a_preparer")
  linesJson   String    @default("[]")
  isDemo      Boolean   @default(true)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Country {
  id     String  @id @default(cuid())
  name   String
  code   String  @unique
  feeEur Float
  feeXof Int
  mobile Boolean @default(false)
}

model Setting {
  id         String  @id @default("shop")
  name       String  @default("Fahmia Kids")
  eurEnabled Boolean @default(true)
  xofEnabled Boolean @default(true)
  games      Boolean @default(false)
  bannerUrl  String?
  tagline    String  @default("Des livres qui éveillent les cœurs et construisent les plus beaux lendemains")
  phone      String  @default("+221 77 123 45 67")
  partners   String  @default("[{\"name\":\"Éditions du Croissant clair\",\"logoUrl\":\"/partners/croissant.svg\"},{\"name\":\"Atelier des Petites Lettres\",\"logoUrl\":\"/partners/lettres.svg\"},{\"name\":\"Maison des Récits\",\"logoUrl\":\"/partners/recits.svg\"}]")
}
